[
    {
        "index": "1",
        "text": "广西建筑工人管理服务信息平台"
    },
    {
        "index": "2",
        "text": "工人端 APP 版操作手册"
    },
    {
        "index": "3",
        "text": "外部文件"
    },
    {
        "index": "4",
        "text": "中国—东盟信息港股份有限公司"
    },
    {
        "index": "5",
        "text": "China-ASEAN Information Harbor Co.,Ltd."
    },
    {
        "index": "6",
        "text": "2023年 09 月产品概要"
    },
    {
        "index": "7",
        "text": "工人版 APP 是平台的配套软件，为工人提供工资保障支持和一站式的行业服"
    },
    {
        "index": "8",
        "text": "务。工人版 APP 主要提供银行卡管理、工资查询、考勤查询等基础功能，帮助建筑"
    },
    {
        "index": "9",
        "text": "工人维护自身获得劳动报酬的合法权益。"
    },
    {
        "index": "10",
        "text": "常见问题咨询"
    },
    {
        "index": "11",
        "text": "客服电话（7*24 小时）：400-6716-888"
    },
    {
        "index": "12",
        "text": "平台在线客服：平台首页右侧→在线目录"
    },
    {
        "index": "13",
        "text": "该页面用于通过身份证号或人脸识别进行登录，同时可进行忘记密码情况下"
    },
    {
        "index": "14",
        "text": "的密码修改。"
    },
    {
        "index": "15",
        "text": "1.1 输入身份证号"
    },
    {
        "index": "16",
        "text": "工人在实名制采集进场后，在此输入需要登录的工人身份证号。"
    },
    {
        "index": "17",
        "text": "1.2 输入密码"
    },
    {
        "index": "18",
        "text": "在此输入工人账号的登录密码，默认密码为身份证后六位。"
    },
    {
        "index": "19",
        "text": "1.3 查看/隐藏密码"
    },
    {
        "index": "20",
        "text": "点击此开关可以显示或隐藏显示用户已输入的密码。"
    },
    {
        "index": "21",
        "text": "1.4 同意用户协议"
    },
    {
        "index": "22",
        "text": "点击勾选阅读并同意用户协议，点击协议按钮可以跳转到协议页面查看具体"
    },
    {
        "index": "23",
        "text": "内容。"
    },
    {
        "index": "24",
        "text": "1.5 登录按钮"
    },
    {
        "index": "25",
        "text": "在身份证及密码已输入且勾选同意用户协议的情况下，点击此按钮进行登"
    },
    {
        "index": "26",
        "text": "录。"
    },
    {
        "index": "27",
        "text": "1.6 刷脸登录"
    },
    {
        "index": "28",
        "text": "点击刷脸登录跳转到刷脸登录页面，通过身份证号+人脸识别验证进行登录。"
    },
    {
        "index": "29",
        "text": "1.7 忘记密码"
    },
    {
        "index": "30",
        "text": "点击忘记密码跳转到忘记密码功能页。输入需要修改密码的身份证号并同意"
    },
    {
        "index": "31",
        "text": "用户协议，点击刷脸验证按钮进行验证。验证成功后，输入新的登录密码并重复"
    },
    {
        "index": "32",
        "text": "确认。"
    },
    {
        "index": "33",
        "text": "2.首页模块"
    },
    {
        "index": "34",
        "text": "该页面为工人端 APP 首页，工人可以通过此页面进入不同的功能进行操作，"
    },
    {
        "index": "35",
        "text": "包括绑定工资卡、考勤查询、工资查询、查看入场邀请。"
    },
    {
        "index": "36",
        "text": "2.1 工资卡功能"
    },
    {
        "index": "37",
        "text": "点击工资卡功能，若用户未绑定工资卡，可以通过选择开户行、输入银行卡"
    },
    {
        "index": "38",
        "text": "账号进行绑定工资卡操作。"
    },
    {
        "index": "39",
        "text": "2.2 考勤查询功能"
    },
    {
        "index": "40",
        "text": "点击考勤查询功能，选择需要查询考勤记录的工程名称，进入考勤日历页，"
    },
    {
        "index": "41",
        "text": "可以查看工人在工程中进行考勤的天数及详细的出勤记录。"
    },
    {
        "index": "42",
        "text": "步骤一、点击考勤查询按钮，进入列表页，选择工人出勤的项目。"
    },
    {
        "index": "43",
        "text": "步骤二、蓝色圆圈代表该日有出勤记录，点击对应的圆圈可以查看考勤详情。"
    },
    {
        "index": "44",
        "text": "步骤三、查看进出工程的考勤记录"
    },
    {
        "index": "45",
        "text": "2.3 工资查询功能"
    },
    {
        "index": "46",
        "text": "该功能用于查询企业给工人发放的工资信息。"
    },
    {
        "index": "47",
        "text": "2.4 入场邀请功能"
    },
    {
        "index": "48",
        "text": "该功能用于企业对已在平台实名认证过的工人邀请加入项目。"
    },
    {
        "index": "49",
        "text": "步骤一、工人点击入场邀请按钮，进入入场邀请记录页面。"
    },
    {
        "index": "50",
        "text": "步骤二、点击企业发来的邀请，在确认工程信息无误后，点击确认按钮。"
    },
    {
        "index": "51",
        "text": "步骤三、在工人授权允许企业使用银行卡及实名制信息后，通过人脸验证，"
    },
    {
        "index": "52",
        "text": "工人即可加入工程。"
    },
    {
        "index": "53",
        "text": "2.5 考勤打卡功能"
    },
    {
        "index": "54",
        "text": "该功能用于工人在未装设闸机的工程中，通过手机进行人脸识别考勤打卡，"
    },
    {
        "index": "55",
        "text": "进入页面后，系统自动识别当前项目及工人当前位置，若在考勤范围中，根据实"
    },
    {
        "index": "56",
        "text": "际情况选择上班或下班打卡，通过人脸识别后即可生成考勤记录。"
    },
    {
        "index": "57",
        "text": "2.6 工友圈"
    },
    {
        "index": "58",
        "text": "工友圈是提供给工人交流的社区平台，工人可以在工友圈发布帖子，评论他"
    },
    {
        "index": "59",
        "text": "人发布的帖子，加入自己感兴趣的圈子，及时关注相关的消息。"
    },
    {
        "index": "60",
        "text": "2.7 招工宝"
    },
    {
        "index": "61",
        "text": "该功能用于工人填写自己的简历，发布到招工平台进行展示，对正在招工的"
    },
    {
        "index": "62",
        "text": "信息进行查看和点击投简历按钮，将自己编辑的简历投递给用工方查看。"
    },
    {
        "index": "63",
        "text": "班组长也可在平台上创建招聘信息。填写工作地区、类型、薪资、福利待遇、"
    },
    {
        "index": "64",
        "text": "招聘人数后即可在平台上发布。"
    },
    {
        "index": "65",
        "text": "2.8 我的合同"
    },
    {
        "index": "66",
        "text": "工人可以查看企业给本人生成的所有合同，工人可查看合同详情，对于需要"
    },
    {
        "index": "67",
        "text": "工人签署的合同，工人进行刷脸实人认证后手写签署。"
    },
    {
        "index": "68",
        "text": "2.9 班组登记"
    },
    {
        "index": "69",
        "text": "该功能用于班组长登记创建自己的班组信息，并对班组成员的加入申请进行"
    },
    {
        "index": "70",
        "text": "管理审核。"
    },
    {
        "index": "71",
        "text": "班组长点击创建专业作业班组，填写班组名称、技能、所在地区、介绍后，"
    },
    {
        "index": "72",
        "text": "即可生成班组。"
    },
    {
        "index": "73",
        "text": "班组长可通过邀请加入班组功能，让其他工人通过工人端 APP 扫一扫二维码"
    },
    {
        "index": "74",
        "text": "或将二维码保存至手机发送到其他地方，即可邀请其他工人加入班组。"
    },
    {
        "index": "75",
        "text": "班组长在接到工人的加入申请后，点击班组新成员申请，可以对加入申请进"
    },
    {
        "index": "76",
        "text": "行查看与审批操纵。"
    },
    {
        "index": "77",
        "text": "2.10 计工记账"
    },
    {
        "index": "78",
        "text": "该功能用于班组长生成班组后，按照不同类型给班组下成员进行记工记账，"
    },
    {
        "index": "79",
        "text": "记录每日工作量，用于生成工资单时提供计算依据。"
    },
    {
        "index": "80",
        "text": "班组长可以点击日期后，选择需要计工的班组成员，选择上班市场、加班时"
    },
    {
        "index": "81",
        "text": "长、填写备注说明与上传图片证明，即可完成工人在当日的计工。"
    },
    {
        "index": "82",
        "text": "2.11 班组工资单"
    },
    {
        "index": "83",
        "text": "该功能用于速生成班组工资单，生成文件给劳资员使用。"
    },
    {
        "index": "84",
        "text": "班组长可以通过工资单功能，选择需要生成工资单的人员，填写工资，系统"
    },
    {
        "index": "85",
        "text": "自动生成工资表格文件，可发送至微信进行打印或查看。"
    },
    {
        "index": "86",
        "text": "3.培训模块"
    },
    {
        "index": "87",
        "text": "3.1 培训功能"
    },
    {
        "index": "88",
        "text": "工人入场前需要进行安全教育培训，可通过线上观看培训视频完成培训，完"
    },
    {
        "index": "89",
        "text": "成培训可以获得相应的积分。"
    },
    {
        "index": "90",
        "text": "工人通过 app 的培训模块，查看课程列表，点击课程可开始学习视频课程，，"
    },
    {
        "index": "91",
        "text": "app 会进行实时的人脸识别检测，确保为工人本人在观看培训视频，若中途工人"
    },
    {
        "index": "92",
        "text": "离开观看手机，则视频课程会暂停播放。"
    },
    {
        "index": "93",
        "text": "4. 我的模块"
    },
    {
        "index": "94",
        "text": "该模块用于查看工人的个人信息及联系客服、反馈问题；同时支持修改密码、"
    },
    {
        "index": "95",
        "text": "修改绑定手机、清空缓存与查看用户协议及退出登录。"
    },
    {
        "index": "96",
        "text": "4.1 工资卡、工资查询、考勤记录、入场邀请功能"
    },
    {
        "index": "97",
        "text": "功能操作详见 2.1~2.4 说明。"
    },
    {
        "index": "98",
        "text": "4.2 帮助与反馈功能"
    },
    {
        "index": "99",
        "text": "该功能用于在线与智能客服沟通及查看、拨打客服热线；同时支持与客服 QQ"
    },
    {
        "index": "100",
        "text": "进行在线交流。"
    },
    {
        "index": "101",
        "text": "4.3 我的投诉"
    },
    {
        "index": "102",
        "text": "该功能用于工人发起对工程、企业的投诉，，工程总包企业可以看到工人发"
    },
    {
        "index": "103",
        "text": "起的投诉，企业会对工人的投诉进行核实处理，并反馈处理结果，工人可以查看"
    },
    {
        "index": "104",
        "text": "处理进度，若对处理结果存在异议，可以发起申诉。"
    },
    {
        "index": "105",
        "text": "工人点击进入功能后，点击我要投诉，选择近半年工作过的工程进行投诉，"
    },
    {
        "index": "106",
        "text": "系统根据工人在平台的考勤、发薪数据自动填入相关数据，工人对欠薪情况进行"
    },
    {
        "index": "107",
        "text": "补充说明后，即可生成投诉记录，等待企业处理。"
    },
    {
        "index": "108",
        "text": "工人可以查看企业对投诉进行的后续处理及说明，查看企业上传的相关材"
    },
    {
        "index": "109",
        "text": "料，对处理结果进行确认。"
    },
    {
        "index": "110",
        "text": "4.4 设置功能"
    },
    {
        "index": "111",
        "text": "该功能用于工人修改密码、绑定手机号、清空缓存或查看用户协议及退"
    },
    {
        "index": "112",
        "text": "出登录。"
    },
    {
        "index": "113",
        "text": "4.4.1 修改密码功能"
    },
    {
        "index": "114",
        "text": "点击修改密码按钮，通过输入旧密码及输入新密码、重复新密码，通过"
    },
    {
        "index": "115",
        "text": "旧密码的校验后，即可修改成功。"
    },
    {
        "index": "116",
        "text": "4.4.2 绑定手机号功能"
    },
    {
        "index": "117",
        "text": "工人账号如果未绑定手机号，点击绑定手机号按钮，通过输入手机号及"
    },
    {
        "index": "118",
        "text": "获取的短信验证码，可以对账号进行手机绑定，后续可以通过手机号及密码"
    },
    {
        "index": "119",
        "text": "进行登录。"
    }
]